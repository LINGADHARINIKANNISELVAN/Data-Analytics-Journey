      <column caption='Product Return Rate' datatype='real' name='[Calculation_0604240803778560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM(&#13;&#10;    IF [Transaction Type] = &quot;Return&quot; THEN [Sales Amount] ELSE 0 END&#13;&#10;))&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Transaction Type] = &quot;Sale&quot; THEN [Sales Amount] ELSE 0 END&#13;&#10;)' />
